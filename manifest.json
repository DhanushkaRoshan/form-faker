{
  "manifest_version": 2,
  "name": "Random Inputs",
  "version": "1.0.0",
  "description": "Right-click any form field to fill it with realistic random data powered by Faker.js",
  "permissions": ["contextMenus", "activeTab"],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
